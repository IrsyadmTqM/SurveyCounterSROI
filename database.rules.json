{
  "rules": {
    "survey": {
      ".read": true,
      "counts": {
        ".write": "newData.exists()",
        ".validate": "newData.hasChildren(['total', 'fr', 'nonfr', 'ws'])",
        "total": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000" },
        "fr": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000" },
        "nonfr": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000" },
        "ws": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000" },
        "$other": { ".validate": false }
      },
      "log": {
        "$entry": {
          ".write": "!data.exists()",
          ".validate": "newData.hasChildren(['by', 'kind', 'at']) && newData.child('by').isString() && newData.child('by').val().length <= 40"
        }
      }
    }
  }
}
