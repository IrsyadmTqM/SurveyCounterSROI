{
  "rules": {
    "surveyCounterSROI": {
      ".read": true,
      "respondents": {
        ".write": true,
        "$id": {
          ".validate": "newData.hasChildren(['fr', 'ws', 'by', 'at'])",
          "fr": { ".validate": "newData.val() == 'fr' || newData.val() == 'nonfr' || newData.val() == 'none'" },
          "ws": { ".validate": "newData.isBoolean()" },
          "by": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "at": { ".validate": "newData.isNumber()" },
          "editedBy": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "editedAt": { ".validate": "newData.isNumber()" },
          "deletedBy": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "deletedAt": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
